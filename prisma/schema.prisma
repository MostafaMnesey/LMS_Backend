generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  password             String
  name                 String
  phone                String                 @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  confirmAt            DateTime?
  roleId               String?                @unique
  code_country         String
  status               String                 @default("pending")
  student              student?
  stuff                stuff?
  subscriptionRequests subscription_requests?
  teacher              teacher?
  role                 role?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([email])
}

model role {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions rolePermission[]
  stuff           stuff[]
  teachers        teacher[]
  user            user?
}

model permission {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  code            String           @unique
  rolePermissions rolePermission[]

  @@index([name])
  @@index([code])
}

model rolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model currency {
  id           String    @id @default(uuid())
  name_en      String
  name_ar      String
  symbol       String
  code         String    @unique
  default      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  exchangeRate Float
  Plans        Plans[]
  teachers     teacher[]

  @@index([name_en])
  @@index([name_ar])
  @@index([code])
}

model Plans {
  id                   String                 @id @default(uuid())
  name_en              String                 @unique
  name_ar              String                 @unique
  description          String
  price                String
  duration             Int
  hours                Float                  @default(0)
  features             String[]
  currencyId           String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  active               Boolean                @default(false)
  bestSeller           Boolean                @default(false)
  currency             currency               @relation(fields: [currencyId], references: [id])
  students             student[]
  subscriptionRequests subscription_requests?

  @@index([name_en])
  @@index([name_ar])
}

model subjects {
  id              String            @id @default(uuid())
  name_en         String            @unique
  name_ar         String            @unique
  active          Boolean           @default(false)
  color           String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  teacherSubjects teacher_subject[]

  @@index([name_en])
  @@index([name_ar])
}

model stuff {
  id           String    @id @default(uuid())
  user_id      String?   @unique
  name         String
  email        String    @unique
  password     String
  phone        String    @unique
  code_country String
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  confirm_at   DateTime?
  roleId       String?
  role         role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user         user?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
}

model teacher {
  id              String            @id @default(uuid())
  user_id         String?           @unique
  name            String
  email           String            @unique
  password        String
  phone           String            @unique
  currencyId      String
  hour_price      Float
  gender          String
  active          Boolean           @default(false)
  code_country    String
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  confirm_at      DateTime?
  roleId          String?
  schedules       schedule[]
  currency        currency          @relation(fields: [currencyId], references: [id])
  role            role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user            user?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  teacherSubjects teacher_subject[]
}

model teacher_subject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model student {
  id              String     @id @default(uuid())
  user_id         String?    @unique
  name            String
  email           String     @unique
  password        String
  phone           String     @unique
  code_country    String
  birth_date      DateTime
  gender          String
  active          Boolean    @default(false)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  hours           Float      @default(0)
  hours_attended  Float      @default(0)
  hours_remaining Float      @default(0)
  confirm_at      DateTime?
  planId          String?
  country         String
  status          String     @default("pending")
  schedules       schedule[]
  plan            Plans?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  user            user?      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
}

model subscription_requests {
  id        String   @id @default(uuid())
  planId    String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user_id   String   @unique
  plan      Plans    @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([planId])
}

model schedule {
  id          String   @id @default(uuid())
  teacherId   String
  studentId   String
  status      String   @default("planned")
  title       String
  description String
  type        String   @default("half")
  start_time  DateTime
  end_time    DateTime
  link        String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  is_recurring        Boolean @default(false)
  day_of_week         String?
  parent_recurring_id String?

  @@index([teacherId])
  @@index([studentId])
  @@index([start_time])
  @@index([end_time])
}
